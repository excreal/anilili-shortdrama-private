# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}
# Persistent Gson records must retain constructors and field names in optimized releases.
-keep class com.example.animepahedl.ExportRecord { *; }
-keep class com.example.animepahedl.DownloadIdentity { *; }
-keep class com.example.animepahedl.PreparationRecord { *; }
-keep class com.example.animepahedl.Anime { *; }
-keep class com.example.animepahedl.Episode { *; }
-keep class com.example.animepahedl.MediaVerification { *; }
# Site batches and per-download request context are persisted alongside legacy records.
-keep class com.example.animepahedl.ResolvedMedia { *; }
-keep class com.example.animepahedl.SiteDownloadPreparation { *; }
-keep class com.example.animepahedl.SiteDownloadPreparationBatch { *; }
-keep class com.example.animepahedl.SiteDownloadSeries { *; }
-keep class com.example.animepahedl.SiteDownloadEpisode { *; }
-keep enum com.example.animepahedl.SiteDownloadProvider { *; }

-keep class fr.acinq.secp256k1.** { *; }
-dontwarn fr.acinq.secp256k1.**
-keep class com.example.animepahedl.Announcement { *; }
-keep class com.example.animepahedl.AnnouncementWorker { *; }

# Persisted host subtitle metadata and the source player's media-session service entry points.
-keep class com.example.animepahedl.MediaSubtitle { *; }
-keep class com.anilili.playback.PlaybackService { *; }
-keep class com.anilili.playback.LocalStreamProxyService { *; }
