# Template only. Copy these exports to .signing/release.env and replace every value locally.
# Never commit your keystore or real credentials.
export ANIMEPAHE_KEYSTORE=/absolute/path/to/release-key.p12
export ANIMEPAHE_STORE_PASSWORD=replace-me
export ANIMEPAHE_KEY_ALIAS=release-key
export ANIMEPAHE_KEY_PASSWORD=replace-me
